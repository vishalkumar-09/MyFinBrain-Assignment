# ============================================================
# Startup Funding Intelligence – Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Date Range (ISO 8601) ---
START_DATE=2024-11-23
END_DATE=2026-11-23

# --- Database ---
DATABASE_URL=sqlite:///data/startups_funding.sqlite

# --- Concurrency & Rate Limiting ---
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Optional: LLM Classification (leave blank to use rule-based classifier) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Optional: Crunchbase API ---
CRUNCHBASE_API_KEY=

# --- Optional: Tracxn API ---
TRACXN_API_KEY=

# --- Optional: PitchBook (export only) ---
# PitchBook does not offer a public API; configure export path.
PITCHBOOK_EXPORT_PATH=

# --- Optional: Dealroom API ---
DEALROOM_API_KEY=

# --- Optional: CB Insights ---
CB_INSIGHTS_API_KEY=

# --- User Agent ---
USER_AGENT=StartupFundingIntelligence/1.0 (research bot; contact@example.com)

# --- Export ---
EXPORT_DIR=data
